# ReTail client-safe public configuration
# Copy this file to .env.local for local development.
# Do not commit .env.local or any private credentials.

EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN=true
EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN_IOS=false
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_CONNECT_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PAYMENTS_ENABLED=
EXPO_PUBLIC_ENABLE_STRIPE_CHECKOUT=false
EXPO_PUBLIC_BETA_FEEDBACK_URL=

# Stripe marketplace fee settings are server-side configuration for future
# Edge Functions. Do not place Stripe secret keys in Expo public variables.
RETAIL_PLATFORM_FEE_PERCENT=10
RETAIL_PLATFORM_MIN_FEE_CENTS=0
RETAIL_PLATFORM_FEE_THRESHOLD_CENTS=500

# Server-only secrets do not belong in the Expo application bundle.
# Keep Supabase service-role keys, database passwords, Apple private keys,
# Google service-account JSON, Stripe secret keys, and access tokens outside
# this file and outside every EXPO_PUBLIC_* variable.
