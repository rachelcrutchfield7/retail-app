# ReTail client-safe public configuration
# Copy this file to .env.local for local development.
# Do not commit .env.local or any private credentials.

EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PAYMENTS_ENABLED=
EXPO_PUBLIC_BETA_FEEDBACK_URL=

# Server-only secrets do not belong in the Expo application bundle.
# Keep Supabase service-role keys, database passwords, Apple private keys,
# Google service-account JSON, Stripe secret keys, and access tokens outside
# this file and outside every EXPO_PUBLIC_* variable.
