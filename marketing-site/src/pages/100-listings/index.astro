---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getValidAlternateEntryFormUrl, promotion } from '../../config/promotion';

const title = '100 Listings in 72 Hours Giveaway | ReTail';
const description = 'Join ReTail’s 100 Listings in 72 Hours Giveaway, October 9–12, 2026. Publish qualifying pet-supply listings for a chance to choose a $50 prize.';
const alternateEntryFormUrl = getValidAlternateEntryFormUrl();
const entryTiers = [
  { listings: '3–5', entries: '1 entry' },
  { listings: '6–8', entries: '2 entries' },
  { listings: '9–11', entries: '3 entries' },
  { listings: '12–14', entries: '4 entries' },
  { listings: '15+', entries: '5 entries' },
];
const prizeOptions = [
  '$50 Chewy gift card',
  '$50 PetSmart gift card',
  '$50 Petco gift card',
  '$50 donation to an eligible animal rescue organization',
];
---
<BaseLayout title={title} description={description} path="/100-listings/" promotionHeader>
  <section class="event-hero">
    <div class="section event-hero-grid">
      <div class="event-hero-copy">
        <span class="event-kicker">Starts October 9</span>
        <h1><span>100 Listings</span> in 72 Hours</h1>
        <p class="lead">List pet supplies, help the ReTail marketplace grow, and earn entries for a chance to choose a $50 gift card or a $50 rescue donation.</p>
        <div class="event-date-card" aria-label="Promotion dates">
          <span>Starts</span>
          <strong><time datetime={promotion.startUtc}>{promotion.startDisplay}</time></strong>
          <span>Ends</span>
          <strong><time datetime={promotion.endUtc}>{promotion.endDisplay}</time></strong>
        </div>
        <div class="actions">
          <a class="button event-button" href="/download/">Open or download ReTail</a>
          <a class="button secondary" href="/100-listings/rules/">Read the Official Rules</a>
        </div>
      </div>
      <aside class="event-goal-card" aria-label="Community listing goal">
        <img src="/retail-site-assets/retail-logo-header.png" alt="ReTail" width="991" height="443" />
        <span class="goal-number">{promotion.targetListingCount}</span>
        <strong>qualifying listings</strong>
        <p>One community. Three days. More pet supplies finding a useful second life.</p>
        <div class="goal-window">72-hour community goal</div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="campaign-progress-title">
    <div
      class="campaign-progress-card"
      data-campaign-progress
      data-status-endpoint="/api/100-listings/status"
      data-start={promotion.startUtc}
      data-end={promotion.endUtc}
      data-target={promotion.targetListingCount}
    >
      <div>
        <span class="eyebrow">Authoritative campaign progress</span>
        <h2 id="campaign-progress-title">Community progress toward 100</h2>
        <p data-progress-message aria-live="polite">The campaign starts October 9. The live qualifying-listing count will appear here when the event begins.</p>
      </div>
      <div class="campaign-progress-meter">
        <strong data-progress-count>0 of {promotion.targetListingCount}</strong>
        <span>qualifying listings recorded</span>
        <div
          class="campaign-progress-track"
          data-progress-track
          role="progressbar"
          aria-label="Qualifying listing progress"
          aria-valuemin="0"
          aria-valuemax={promotion.targetListingCount}
          aria-valuenow="0"
          hidden
        >
          <span data-progress-fill></span>
        </div>
      </div>
    </div>
    <p class="campaign-progress-note">The 100-listing count is a community goal. Individual sweepstakes entries are awarded separately under the Official Rules.</p>
  </section>

  <section class="section" id="how-it-works">
    <div class="section-header centered">
      <span class="eyebrow">How listing entries work</span>
      <h2>The more qualifying listings you publish, the more entries you earn.</h2>
      <p>Publish legitimate pet-related sale listings in ReTail during the Promotion Period. A maximum of five entries is available per eligible participant.</p>
    </div>
    <div class="entry-tier-grid" aria-label="Listing entry tiers">
      {entryTiers.map((tier) => (
        <article class="entry-tier-card">
          <strong>{tier.listings}</strong>
          <span>qualifying listings</span>
          <b>{tier.entries}</b>
        </article>
      ))}
    </div>
    <div class="event-note">
      <strong>What qualifies?</strong>
      <p>Listings must be legitimate pet-related sale listings and comply with ReTail’s applicable terms and listing rules. Duplicate, fraudulent, misleading, spam, prohibited, or otherwise invalid listings do not qualify.</p>
    </div>
  </section>

  <section class="section event-prize-section">
    <div class="event-prize-copy">
      <span class="eyebrow light">One winner · $50 value</span>
      <h2>The winner chooses the prize.</h2>
      <p>Choose a $50 gift card from one of three pet-supply retailers, or direct a $50 Sponsor donation to an eligible animal rescue organization.</p>
    </div>
    <div class="prize-option-grid">
      {prizeOptions.map((prize, index) => (
        <div class="prize-option">
          <span>{index + 1}</span>
          <strong>{prize}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="community-goal-band">
      <div>
        <span class="eyebrow">Community goal</span>
        <h2>Let’s reach 100 qualifying listings together.</h2>
      </div>
      <p>The goal celebrates marketplace growth and encourages participation. Reaching 100 listings is not required for the prize to be awarded. The Sponsor’s records determine the official qualifying-listing count.</p>
    </div>
  </section>

  <section class="section" id="alternate-entry">
    <div class="alternate-entry-card">
      <div>
        <span class="eyebrow">No purchase necessary</span>
        <h2>Don’t have items to list?</h2>
        <p>You can enter for free using the Official Alternate Entry Form. No purchase, sale, ReTail listing, payment, or marketing consent is required.</p>
        <div class="alternate-entry-summary">
          <strong>One valid alternate entry submission provides five entries</strong>
          <span>That is equal to the maximum available through listing items. Limit five total entries per person, regardless of entry method or combination of methods.</span>
        </div>
        <p>Only one valid Alternate Entry Form submission per eligible person is permitted. See the <a href="/100-listings/rules/">Official Rules</a> for eligibility, timing, and all Promotion terms.</p>
      </div>
      {alternateEntryFormUrl && (
        <a class="button event-button" href={alternateEntryFormUrl} target="_blank" rel="noreferrer">Open the Official Alternate Entry Form</a>
      )}
    </div>
  </section>

  <section class="section event-final-cta">
    <div>
      <span class="eyebrow">Ready to list?</span>
      <h2>Give pet supplies another life.</h2>
      <p>Open ReTail, publish qualifying sale listings during the Promotion Period, and help the community work toward 100.</p>
    </div>
    <div class="actions">
      <a class="button event-button" href="/download/">Open or download ReTail</a>
      <a class="button secondary" href="/100-listings/rules/">Official Rules</a>
    </div>
  </section>
</BaseLayout>

<script>
  const campaignProgress = document.querySelector<HTMLElement>('[data-campaign-progress]');

  if (campaignProgress) {
    const endpoint = campaignProgress.dataset.statusEndpoint;
    const fallbackTarget = Number(campaignProgress.dataset.target || '100');
    const message = campaignProgress.querySelector<HTMLElement>('[data-progress-message]');
    const count = campaignProgress.querySelector<HTMLElement>('[data-progress-count]');
    const track = campaignProgress.querySelector<HTMLElement>('[data-progress-track]');
    const fill = campaignProgress.querySelector<HTMLElement>('[data-progress-fill]');

    const updateProgress = (status: {
      qualifyingListingCount: number;
      targetListingCount: number;
      lifecycle: 'disabled' | 'upcoming' | 'active' | 'ended' | 'unavailable';
      goalReached: boolean;
    }) => {
      const qualifyingCount = Math.max(0, Math.floor(status.qualifyingListingCount));
      const target = Math.max(1, Math.floor(status.targetListingCount || fallbackTarget));
      const percent = Math.min(100, (qualifyingCount / target) * 100);

      if (count) count.textContent = `${qualifyingCount} of ${target}`;
      if (track) {
        track.setAttribute('aria-valuemax', String(target));
        track.setAttribute('aria-valuenow', String(qualifyingCount));
      }
      if (fill) fill.style.width = `${percent}%`;

      if (status.lifecycle === 'upcoming') {
        if (message) message.textContent = 'The campaign starts October 9. No pre-event listings count toward the new campaign.';
        if (track) track.hidden = true;
      } else if (status.lifecycle === 'ended') {
        if (message) message.textContent = 'The Promotion Period has ended. This is the final recorded community progress.';
        if (track) track.hidden = false;
      } else if (status.lifecycle !== 'active') {
        if (message) message.textContent = 'Campaign progress is currently unavailable.';
        if (track) track.hidden = true;
      } else if (status.goalReached) {
        if (message) message.textContent = 'The community reached the 100-listing goal! Entries remain open through the end of the Promotion Period.';
        if (track) track.hidden = false;
      } else {
        if (message) message.textContent = 'The event is live. This count comes from ReTail’s authoritative campaign records.';
        if (track) track.hidden = false;
      }
    };

    if (endpoint) {
      fetch(endpoint, { headers: { Accept: 'application/json' } })
        .then((response) => {
          if (!response.ok) throw new Error(`Campaign status returned ${response.status}`);
          return response.json();
        })
        .then(updateProgress)
        .catch(() => {
          if (message) message.textContent = 'Live progress is temporarily unavailable. Entry rules and the Promotion Period are unaffected.';
          if (track) track.hidden = true;
        });
    }
  }
</script>
