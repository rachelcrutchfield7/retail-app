---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'ReTail | Secondhand Pet Supplies Marketplace';
const description = 'ReTail is a secondhand pet-supply marketplace for buying, selling, giving away, and donating pet supplies to verified animal rescues.';
const features = [
  {
    title: 'Shop pet supplies for less',
    body: 'Discover crates, carriers, beds, toys, tanks, grooming supplies, and other pet items nearby while giving useful supplies another life.',
  },
  {
    title: 'Clear out what you no longer use',
    body: 'List extra supplies with photos, condition details, pickup options, pricing, or a free giveaway setting in just a few steps.',
  },
  {
    title: 'Send supplies toward rescues',
    body: 'Offer eligible items specifically to verified animal rescue organizations when you want them to support rescue work.',
  },
  {
    title: 'Check Rescue Hub first',
    body: 'See verified rescues, urgent supply needs, wishlists, and available rescue donations in your area.',
  },
];
const funnelStats = [
  { value: 'Buy', label: 'affordable secondhand supplies' },
  { value: 'Sell', label: 'pet gear your family outgrew' },
  { value: 'Give', label: 'items directly to rescues or neighbors' },
];
const safetyPoints = [
  'ReTail is for pet supplies only.',
  'Live animals may not be listed or transferred through ReTail.',
  'Users can report listings, messages, or accounts.',
  'Exact home addresses are not displayed in public marketplace views.',
  'Users arrange pickup, meetup, shipping, or donation details through private messages.',
  'Rescue-only donations are intended for verified rescue organizations.',
];
---
<BaseLayout title={title} description={description} path="/">
  <section class="hero">
    <div class="section hero-grid">
      <div class="hero-copy">
        <div class="funnel-pill">Currently in private beta</div>
        <span class="eyebrow">Secondhand pet supplies</span>
        <h1>Pet supplies deserve a second life.</h1>
        <p class="lead">ReTail is a pet-focused marketplace where people can buy, sell, give away, and donate supplies, with Rescue Hub built in for animal rescues and community support.</p>
        <div class="actions">
          <a class="button" href="/how-it-works">See how ReTail works</a>
          <a class="button secondary" href="/private-beta">Private beta details</a>
        </div>
        <p class="download-note">Public app access and payment services are not live yet. ReTail is being tested with a limited group before launch.</p>
        <div class="funnel-stat-row" aria-label="What ReTail helps users do">
          {funnelStats.map((stat) => (
            <div class="funnel-stat">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
      <aside class="brand-showcase" aria-label="ReTail private beta overview">
        <img src="/assets/retail-logo-header.png" alt="ReTail logo" width="991" height="443" />
        <div class="showcase-panel">
          <span>Private beta focus</span>
          <strong>Pet supplies only</strong>
          <p>No live animals, no unrelated classifieds, and clearer paths for rescue donations.</p>
        </div>
        <div class="showcase-grid">
          <div>
            <strong>Marketplace</strong>
            <span>Buy, sell, or give away useful supplies.</span>
          </div>
          <div>
            <strong>Rescue Hub</strong>
            <span>See rescue needs and donation options.</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section-header centered">
      <span class="eyebrow">What ReTail Helps With</span>
      <h2>A marketplace made for the supplies pets actually use.</h2>
      <p>ReTail keeps secondhand pet-supply shopping focused, organized, and connected to rescue needs instead of buried inside general classifieds.</p>
    </div>
    <div class="grid">
      {features.map((feature) => (
        <article class="card homepage-feature-card">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="band homepage-band">
      <span class="eyebrow light">Built-in guardrails</span>
      <h2>Built for pet supplies and community safety</h2>
      <p>ReTail is designed around pet-supply exchanges rather than a general classifieds feed. The marketplace rules, reporting paths, and Rescue Hub experience are built for that narrower purpose.</p>
      <div class="trust-strip">
        {safetyPoints.map((point) => <span>{point}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="download-cta homepage-cta">
      <img src="/assets/retail-logo-header.png" alt="ReTail" width="991" height="443" />
      <div>
        <span class="eyebrow">Company</span>
        <h2>Built from firsthand animal-rescue experience.</h2>
        <p>ReTail was created to make useful pet supplies more affordable, keep usable items out of landfills, and help animal rescues connect with community members who want to support their work.</p>
        <p>ReTail is owned and operated by Crutchfield Interactive LLC.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card beta-card">
      <span class="eyebrow">Private Beta</span>
      <h2>Interested in ReTail?</h2>
      <p>ReTail is currently in private beta. Contact us to ask a question, learn about the upcoming public launch, or inquire about rescue participation.</p>
      <div class="actions">
        <a class="button" href="mailto:contact@retailpetapp.com">General questions</a>
        <a class="button secondary" href="mailto:support@retailpetapp.com">Support</a>
      </div>
    </div>
  </section>
</BaseLayout>
