---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found | ReTail"
  description="The ReTail page you requested could not be found."
  path="/404"
>
  <section class="section page-hero narrow">
    <span class="eyebrow">404</span>
    <h1>That page wandered off.</h1>
    <p class="lead">The page you are looking for is not available. ReTail is currently in private beta, so some public resources may move as the website grows.</p>
    <div class="actions">
      <a class="button" href="/">Return home</a>
      <a class="button secondary" href="/contact">Contact ReTail</a>
    </div>
  </section>
</BaseLayout>
