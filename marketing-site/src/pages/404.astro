---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found | ReTail"
  description="The ReTail page you requested could not be found."
  path="/404"
  noindex
>
  <section class="section page-hero narrow">
    <span class="eyebrow">404</span>
    <h1>That page wandered off.</h1>
    <p class="lead">The page you are looking for could not be found. Visit the ReTail homepage or download the app to continue.</p>
    <div class="actions">
      <a class="button" href="/">Return home</a>
      <a class="button secondary" href="/download/">Download ReTail</a>
    </div>
  </section>
</BaseLayout>
