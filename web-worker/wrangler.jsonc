    {
      "pattern": "retailpetapp.com/listing/*",
      "zone_name": "retailpetapp.com"
    },
    {
      "pattern": "retailpetapp.com/.well-known/*",
      "zone_name": "retailpetapp.com"
    }
  ],
  "vars": {
    "APPLE_TEAM_ID": "9B32TBC7RK",
    "ANDROID_SHA256_CERT_FINGERPRINT": "13:5D:FF:FF:10:D6:3F:58:36:1B:2B:15:ED:09:B3:3C:5F:40:56:4E:6A:EE:A5:D6:C1:54:18:DB:C7:3A:C8:11"
  }
}
