{
  "name": "retail-mobile-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/prepare-file-preview.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --import ./tests/register-ts-loader.mjs --test tests/*.test.mjs",
    "test:live": "RUN_LIVE_SUPABASE_TESTS=1 node --import ./tests/register-ts-loader.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "node scripts/format-check.mjs",
    "format:fix": "node scripts/format-check.mjs --fix",
    "security:audit": "node scripts/dependency-audit.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:secrets:history": "node scripts/secret-scan.mjs --git-history",
    "check:protected-ui": "node scripts/check-protected-ui-changes.mjs",
    "report:task-diff": "node scripts/report-task-diff.mjs",
    "compare:golden-layout": "node scripts/compare-golden-layout.mjs",
    "check:beta-guardrails": "pnpm check:protected-ui && pnpm report:task-diff",
    "install:beta-git-hooks": "node scripts/install-retail-git-hooks.mjs",
    "validate:beta-build-config": "node scripts/validate-beta-build-config.mjs --profile-preview",
    "validate:preview-bundle-config": "node scripts/verify-preview-bundle-config.mjs",
    "eas-build-pre-install": "node scripts/validate-beta-build-config.mjs",
    "build:preview:ios": "pnpm check:beta-guardrails && eas build --profile preview --platform ios",
    "build:preview:android": "pnpm check:beta-guardrails && eas build --profile preview --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@stripe/stripe-react-native": "^0.71.0",
    "@supabase/supabase-js": "2.110.2",
    "@tanstack/react-query": "5.101.2",
    "expo": "57.0.8",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "expo-doctor": "1.20.0",
    "typescript": "~6.0.3"
  }
}
