{
  "name": "retail-mobile-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/prepare-file-preview.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --import ./tests/register-ts-loader.mjs --test tests/*.test.mjs",
    "test:live": "RUN_LIVE_SUPABASE_TESTS=1 node --import ./tests/register-ts-loader.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "node scripts/format-check.mjs",
    "format:fix": "node scripts/format-check.mjs --fix",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@supabase/supabase-js": "2.110.2",
    "@tanstack/react-query": "5.101.2",
    "expo": "57.0.4",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-secure-store": "57.0.0",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  }
}
