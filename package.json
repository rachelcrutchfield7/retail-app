{
  "name": "retail-mobile-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/prepare-file-preview.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --import ./tests/register-ts-loader.mjs --test tests/*.test.mjs",
    "test:live": "RUN_LIVE_SUPABASE_TESTS=1 node --import ./tests/register-ts-loader.mjs --test tests/*.test.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@supabase/supabase-js": "latest",
    "expo": "latest",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  }
}
